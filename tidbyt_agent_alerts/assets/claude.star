def main(config):
    message = config.str("message", DEFAULT_MESSAGE)
    gif_choice = config.get("gif", DEFAULT_GIF)
    center = CLAUDE_GIFS.get(gif_choice, CLAUDE_GIFS[DEFAULT_GIF])

    return render.Root(
        delay = 80,
        child = render.Box(
            color = "#000000",
            child = render.Column(
                expanded = True,
                main_align = "space_evenly",
                cross_align = "center",
                children = [
                    render.Row(
                        main_align = "space_evenly",
                        cross_align = "center",
                        expanded = True,
                        children = [
                            render.Image(src = ALERT, width = 18, height = 18),
                            render.Image(src = center, width = 18, height = 18),
                            render.Image(src = ALERT, width = 18, height = 18),
                        ],
                    ),
                    render.Marquee(
                        width = 64,
                        offset_start = 32,
                        offset_end = 32,
                        child = render.Text(message, font = "tom-thumb"),
                        align = "center",
                    ),
                ],
            ),
        ),
    )

def get_schema():
    return schema.Schema(
        version = "1",
        fields = [
            schema.Text(
                id = "message",
                name = "Message",
                desc = "Text shown under the alert (e.g. working directory or session name).",
                icon = "message",
                default = DEFAULT_MESSAGE,
            ),
            schema.Dropdown(
                id = "gif",
                name = "Claude Animation",
                desc = "Which Claude animation to show between the alerts.",
                icon = "wandMagicSparkles",
                default = DEFAULT_GIF,
                options = [
                    schema.Option(display = "Thinking", value = "thinking"),
                    schema.Option(display = "Loading", value = "loading"),
                    schema.Option(display = "Sparkle", value = "sparkle"),
                    schema.Option(display = "Wave", value = "wave"),
                ],
            ),
        ],
    )
