# Documentation only. Run `tidbyt-agent-alerts setup` to create private config.
# Values are JSON-quoted strings, parsed as data, not sourced by a shell.
TIDBYT_BASE_URL="https://api.tidbyt.com/v0/devices"
TIDBYT_API_KEY="REPLACE_WITH_YOUR_KEY"
TIDBYT_DEVICE_ID="REPLACE_WITH_YOUR_DEVICE_ID"
# neutral, claude, or agent (Codex/OpenCode artwork; neutral for other sources).
TIDBYT_THEME="neutral"
TIDBYT_ANIMATION="thinking"
TIDBYT_PIXLET="/absolute/path/to/pixlet"
# Empty disables brightness changes. Otherwise an integer from 0 through 100.
TIDBYT_ALERT_BRIGHTNESS=""
# Brightness hold time, not firmware display duration.
TIDBYT_ALERT_SECONDS="15"
TIDBYT_COOLDOWN_SECONDS="10"
# Enable only after accepting that HTTP exposes your API key to the network.
TIDBYT_ALLOW_HTTP="false"
